# Copie este archivo como .env (no se sube a git) y complete los valores.
# En GitHub Actions estos valores se configuran en Settings → Secrets and variables → Actions.

# Base de datos del panel
DB_HOST=localhost
DB_NOMBRE=rubicam_db
DB_USUARIO=root
DB_CLAVE=

# Usuario con permisos limitados que usa el chat público (solo INSERT en web_leads y ws_avisos)
DB_WEB_USUARIO=rubicam_web
DB_WEB_CLAVE=

# Asistentes de IA (n8n)
N8N_USAR_TEST=true
N8N_URL_PANEL=http://localhost:5678/webhook/asistente-rubicam
N8N_CLAVE_PANEL=
N8N_URL_PUBLICO=http://localhost:5678/webhook/chat-publico-rubicam
N8N_CLAVE_PUBLICA=
